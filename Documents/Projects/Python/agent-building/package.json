{
  "name": "invoice-ocr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"npm run worker\"",
    "build": "next build",
    "start": "next start",
    "worker": "ts-node --project tsconfig.worker.json workers/index.ts",
    "test": "jest --forceExit",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --project tsconfig.worker.json prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "next": "14.2.0",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^9.0.0",
    "resend": "^4.0.0",
    "zod": "^3.23.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "canvas", "msgpackr-extract", "unrs-resolver"]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.0.0",
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5",
    "eslint": "^8",
    "eslint-config-next": "14.2.0",
    "tailwindcss": "^3",
    "autoprefixer": "^10",
    "postcss": "^8",
    "@prisma/client": "^5.0.0",
    "prisma": "^5.0.0"
  }
}
